#!/bin/bash
# postinstall for "Uninstall Advanced Exporter for PowerPoint.pkg".
#
# Takes every copy of this add-in's manifest out of PowerPoint's wef folder —
# the installer's, and the sideload script's — matched on the add-in's <Id>, so
# other add-ins in the folder are never touched. The Id is read from the
# manifest bundled beside this script rather than written in here, so the two
# packages cannot disagree about which add-in they mean.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
id="$(sed -n 's:.*<Id>\(.*\)</Id>.*:\1:p' "$here/manifest.xml" | head -n 1)"
[ -n "$id" ] || { echo "advanced-exporter: no <Id> in the bundled manifest" >&2; exit 1; }

if [ "$(id -u)" -eq 0 ]; then
  user="$(stat -f %Su /dev/console)"
  if [ -z "$user" ] || [ "$user" = "root" ] || [ "$user" = "loginwindow" ]; then
    echo "advanced-exporter: nobody is logged in at the console to uninstall for" >&2
    exit 1
  fi
  home="$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')"
  as_user() { sudo -u "$user" "$@"; }
else
  home="$HOME"
  as_user() { "$@"; }
fi

wef="$home/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef"
removed=0
for f in "$wef"/*.xml; do
  [ -f "$f" ] || continue
  if grep -q "<Id>$id</Id>" "$f"; then
    as_user rm -f "$f"
    echo "advanced-exporter: removed $f"
    removed=$((removed + 1))
  fi
done
[ "$removed" -gt 0 ] || echo "advanced-exporter: nothing to remove; it was not installed"

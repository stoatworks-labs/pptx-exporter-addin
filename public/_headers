# Response headers for the hosted add-in (Cloudflare assets runtime).
#
# Not the fleet's usual CSP, on purpose — each difference would break the
# add-in if "fixed" back to the house pattern:
#
#   script-src      Office.js must load from https://appsforoffice.microsoft.com
#                   (Microsoft requires the CDN copy), and pulls its
#                   host-specific bundle from there at runtime.
#                   'wasm-unsafe-eval' is for the WebP/AVIF encoders (jSquash)
#                   and pdf.js — WebAssembly, not eval: no string is ever run
#                   as code.
#   worker-src      pdf.js runs in a module worker served from this origin.
#   frame-ancestors PowerPoint on the web frames the pane from Microsoft's
#                   Office hosts, so no `frame-ancestors 'none'` and no
#                   X-Frame-Options: DENY.
#   connect-src     Only this origin (fonts and codecs it fetches from itself)
#                   and Office.js's own host. The add-in never uploads
#                   anything.
#
# Office.js also tries to frame https://telemetryservice.firstpartyapps.oaspapps.com/
# (Microsoft's add-in telemetry). frame-src falls back to 'self', so that is
# refused with one console error and nothing depends on it.
#
# Check a change with `npm run serve:dist`, which applies these headers locally.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://appsforoffice.microsoft.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' https://appsforoffice.microsoft.com https://intake.stoatworks-labs.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://*.officeapps.live.com https://*.office.com https://*.office.net https://*.cloud.microsoft https://*.microsoft.com https://*.sharepoint.com https://*.live.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Office caches task-pane pages hard. Revalidating the HTML means a deploy is
# picked up the next time the pane opens; everything it references is
# content-hashed anyway.
/taskpane.html
  Cache-Control: no-cache

/manifest.xml
  Cache-Control: no-cache
